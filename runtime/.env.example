# Copy to .env and fill in values before starting.
PORT=3000
# Loopback-only by default. Set to 0.0.0.0 only if you specifically need LAN/container access.
HOST=127.0.0.1

# Path to the SQLite database file (created automatically on first run).
DB_PATH=./data/carc.db

# Identifier returned in every verification response.
VERIFIER_ID=CARC-RUNTIME-VERIFIER-001

# HMAC secret used to sign RUNTIME_VERIFIED responses.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=change-this-to-a-strong-random-secret

# Comma-separated allowlist of origins permitted to read this server's responses from a
# browser. '*' accepts any website's JS (real risk even on loopback — any tab can reach a
# server on 127.0.0.1) and is only honored if set explicitly, never assumed.
CORS_ORIGIN=http://127.0.0.1:8080,http://localhost:8080

# Server-authoritative threshold (ms) for GET /api/sync-status to report a sync type as
# STALE rather than CURRENT. Independent of any browser's local auto-sync interval.
SYNC_STALE_THRESHOLD_MS=900000
